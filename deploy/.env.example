# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
#
# Run deploy/scripts/setup.sh to auto-generate the secret values below.

# ── Domain ──────────────────────────────────────────────────────────────────
# Your server's hostname. On a local network you can use an IP or mDNS name.
# If you set a real domain, Caddy will obtain a Let's Encrypt certificate automatically.
LANDFALL_DOMAIN=landfall.local

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=landfall
DB_USER=landfall
DB_PASSWORD=replace_with_generated_secret

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_generated_secret

# ── Serverpod secrets (auto-generated by setup.sh) ──────────────────────────
SERVERPOD_SERVICE_SECRET=replace_with_generated_secret
JWT_HMAC_KEY=replace_with_generated_secret
JWT_REFRESH_PEPPER=replace_with_generated_secret

# ── API key service (auto-generated by setup.sh) ─────────────────────────────
# Protects the ApiKeyEndpoint management operations.
API_KEY_MANAGEMENT_TOKEN=replace_with_generated_secret
# HMAC-SHA-256 key for hashing API keys at rest.
# Changing this invalidates all existing issued API keys.
API_KEY_HMAC_SECRET=replace_with_generated_secret

# ── Photo signing (auto-generated by setup.sh) ───────────────────────────────
# HMAC-SHA256 secret for signing photo serve URLs.
# Generate with: openssl rand -base64 32
PHOTO_SIGNING_SECRET=replace_with_generated_secret

# ── OAuth token encryption (auto-generated by setup.sh) ──────────────────────
# AES-256 key used to encrypt Google/Microsoft OAuth tokens at rest.
# Generate with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_generated_secret

# ── Weather (optional) ───────────────────────────────────────────────────────
# Free tier at openweathermap.org/api — 60 calls/min is more than enough.
# Leave blank to disable weather cards.
OWM_API_KEY=

# ── Google Calendar (optional) ───────────────────────────────────────────────
# Create a project at console.cloud.google.com, enable the Calendar API,
# add an OAuth 2.0 client ID (Web application), and register the redirect URI:
#
#   https://<your-domain>/calendar/oauth/callback
#
# `<your-domain>` must match the LANDFALL_DOMAIN you set above and must be a
# domain Google will accept (a real domain name or a registered TLD — Google
# rejects .local hostnames and bare IPs). If your Pi only has a .local
# hostname, see "OAuth without a public domain" below.
#
# Leave all three blank to disable Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── OAuth without a public domain (fallback) ─────────────────────────────────
# Only needed if Google rejects your LANDFALL_DOMAIN (e.g. .local, bare IP).
# When set, the server accepts a one-time bootstrap request that links a Google
# account without a real display session:
#
#   https://<domain>/calendar/oauth/start?setup_token=<value>&authUserId=<uuid>
#
# Generate with: openssl rand -base64 24
# Clear (set empty) immediately after linking — it's a bearer secret.
# See docs/self_hosting_guide.md → "OAuth without a public domain".
CALENDAR_OAUTH_SETUP_TOKEN=

# ── Google Drive photos (optional) ───────────────────────────────────────────
# Recommended path: service account. See docs/self_hosting_guide.md for the
# full walk-through. Summary:
#   1. In Google Cloud Console, create a service account, enable Drive API,
#      and download the JSON key.
#   2. Share your Drive photo folder with the service account's email
#      (Reader access).
#   3. Paste the values below.
#
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY must be on one line with literal \n
# between PEM lines, wrapped in double quotes. Example:
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# If the service account variables are left blank, photo sync falls back to
# the OAuth user-credential flow (uses GOOGLE_CLIENT_ID/SECRET above plus
# the credential connected via the calendar OAuth start URL).
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Microsoft Calendar (optional) ────────────────────────────────────────────
# Register an app at portal.azure.com, add Calendars.Read permission,
# and set the redirect URI to:
#   https://<LANDFALL_DOMAIN>/calendar/microsoft/oauth/callback
# Leave all blank to disable Microsoft integration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# ── Stripe webhook (required if using Stripe) ─────────────────────────────────
# Found under Developers > Webhooks in your Stripe dashboard.
# Without this, the webhook endpoint rejects all incoming events (fail-closed).
STRIPE_WEBHOOK_SECRET=

# ── OTP email sign-in ────────────────────────────────────────────────────────
# Configure SMTP so Landfall can email one-time sign-in codes.
# Examples:
#   SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USERNAME=apikey, SMTP_PASSWORD=<api key>
#   Gmail: use an app password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Landfall
# Use true for implicit TLS on port 465. Leave false for STARTTLS on 587.
SMTP_SSL=false
# Development only. Allows unencrypted SMTP when the server does not support STARTTLS.
SMTP_ALLOW_INSECURE=false
# Development only. If true and SMTP is blank, OTP codes are written to server logs.
OTP_LOG_CODES=false
