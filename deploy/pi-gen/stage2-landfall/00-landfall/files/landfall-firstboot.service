[Unit]
Description=Landfall first-boot setup (secrets + Docker image load)
After=docker.service
Requires=docker.service
Before=landfall-server.service
ConditionPathExists=!/var/lib/landfall/.initialized

[Service]
Type=oneshot
ExecStart=/opt/landfall/firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
