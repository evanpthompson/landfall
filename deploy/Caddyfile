{$LANDFALL_DOMAIN} {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$LANDFALL_DOMAIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self'"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Web server routes (OAuth callbacks, static pages) — must come before
    # the API catch-alls so Caddy's longest-prefix matching picks these first.
    reverse_proxy /calendar/oauth/* server:8082
    reverse_proxy /calendar/microsoft/oauth/* server:8082
    reverse_proxy /stripe/* server:8082
    # /app/* is intentionally absent. The Serverpod scaffold's web UI is not
    # used; the only Flutter web bundle is the companion, served at /c/<id>/
    # by CompanionPageRoute (which injects the display ID). See the "Web
    # admin UI" backlog item in docs/roadmap.md for the post-beta plan.

    # API server (HTTP + WebSocket)
    reverse_proxy /api/* server:8080
    reverse_proxy /card/* server:8080
    reverse_proxy /agent/* server:8080
    reverse_proxy /calendar/* server:8080
    # Named matcher covers both the bare path (/companion) and all sub-paths
    # (/companion/*). Inline multi-path syntax ("reverse_proxy /a /b upstream")
    # is invalid — Caddy treats the second path as a second upstream address,
    # causing intermittent 502s via round-robin against an invalid dial target.
    @companion path /companion /companion/*
    reverse_proxy @companion server:8080
    # Serverpod endpoints called by the web settings UI (Phase 3).
    # Each matcher covers the bare endpoint path and all method sub-paths.
    @otp path /otp /otp/*
    reverse_proxy @otp server:8080
    @jwtRefresh path /jwtRefresh /jwtRefresh/*
    reverse_proxy @jwtRefresh server:8080
    @passkeyIdp path /passkeyIdp /passkeyIdp/*
    reverse_proxy @passkeyIdp server:8080
    @layout path /layout /layout/*
    reverse_proxy @layout server:8080
    @profile path /profile /profile/*
    reverse_proxy @profile server:8080
    @theme path /theme /theme/*
    reverse_proxy @theme server:8080
    @marketplace path /marketplace /marketplace/*
    reverse_proxy @marketplace server:8080
    @settings path /settings /settings/*
    reverse_proxy @settings server:8080
    @apiKey path /apiKey /apiKey/*
    reverse_proxy @apiKey server:8080
    @license path /license /license/*
    reverse_proxy @license server:8080
    @pack path /pack /pack/*
    reverse_proxy @pack server:8080
    reverse_proxy /photos/* server:8082

    # WebSocket endpoint for real-time card push
    reverse_proxy /websocket server:8080

    # Catch-all: everything else goes to the web server (serves root page,
    # photo redirects, OAuth callback pages, etc.).
    reverse_proxy server:8082
}
