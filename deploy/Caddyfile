{$LANDFALL_DOMAIN} {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$LANDFALL_DOMAIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self'"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Web server routes (OAuth callbacks, static pages) — must come before
    # the API catch-alls so Caddy's longest-prefix matching picks these first.
    reverse_proxy /calendar/oauth/* server:8082
    reverse_proxy /calendar/microsoft/oauth/* server:8082
    reverse_proxy /stripe/* server:8082
    reverse_proxy /app/* server:8082

    # API server (HTTP + WebSocket)
    reverse_proxy /api/* server:8080
    reverse_proxy /card/* server:8080
    reverse_proxy /agent/* server:8080
    reverse_proxy /calendar/* server:8080
    # Serverpod POSTs the endpoint call to /companion (no trailing slash).
    # The /* glob alone does not match the bare path, so list both — otherwise
    # the request falls through to the catch-all webserver and returns 405.
    reverse_proxy /companion /companion/* server:8080
    reverse_proxy /photos/* server:8082

    # WebSocket endpoint for real-time card push
    reverse_proxy /websocket server:8080

    # Catch-all: everything else goes to the web server (serves root page, /app)
    reverse_proxy server:8082
}
