# Copy this file to passwords.yaml and fill in real values.
# passwords.yaml is gitignored — never commit it.
#
# Generate secrets with: openssl rand -base64 32

shared:
  # mySharedPassword: 'replace_me'

development:
  database: 'replace_with_local_db_password'
  serviceSecret: 'replace_with_32_char_random_string'
  jwtHmacSha512PrivateKey: 'replace_with_32_char_random_string'
  jwtRefreshTokenHashPepper: 'replace_with_32_char_random_string'
  # The relying party hostname for WebAuthn passkeys.
  # Use 'localhost' for local development.
  passkeyHostname: 'localhost'
  # Protects the ApiKeyEndpoint (generateKey/listKeys/revokeKey).
  # Required — set to any strong secret before using key management locally.
  apiKeyManagementToken: 'replace_with_strong_secret'

test:
  database: 'replace_with_test_db_password'
  serviceSecret: 'replace_with_32_char_random_string'
  jwtHmacSha512PrivateKey: 'replace_with_32_char_random_string'
  jwtRefreshTokenHashPepper: 'replace_with_32_char_random_string'
  passkeyHostname: 'localhost'
  # Must match _validToken in api_key_endpoint_test.dart — do not change here.
  apiKeyManagementToken: 'test-management-token'

production:
  database: 'replace_with_prod_db_password'
  serviceSecret: 'replace_with_32_char_random_string'
  jwtHmacSha512PrivateKey: 'replace_with_32_char_random_string'
  jwtRefreshTokenHashPepper: 'replace_with_32_char_random_string'
  # Set to your production domain (e.g. 'api.makefastlandfall.com').
  passkeyHostname: 'replace_with_production_hostname'
  # Protects the ApiKeyEndpoint — required before any public deployment.
  # Generate with: openssl rand -base64 32
  apiKeyManagementToken: 'replace_with_strong_secret'
