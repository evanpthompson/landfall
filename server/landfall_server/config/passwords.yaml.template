# Generated from passwords.yaml.template at container startup via envsubst.
# Do not edit this file directly — set values in your .env file.

production:
  # Serverpod core secrets — auto-generated by deploy/scripts/setup.sh
  database: '${DB_PASSWORD}'
  serviceSecret: '${SERVERPOD_SERVICE_SECRET}'
  jwtHmacSha512PrivateKey: '${JWT_HMAC_KEY}'
  jwtRefreshTokenHashPepper: '${JWT_REFRESH_PEPPER}'
  passkeyHostname: '${LANDFALL_DOMAIN}'

  # Weather — optional; leave blank to disable weather cards
  openWeatherMapApiKey: '${OWM_API_KEY}'

  # Google Calendar + Drive — optional; leave blank to disable
  googleOAuthClientId: '${GOOGLE_CLIENT_ID}'
  googleOAuthClientSecret: '${GOOGLE_CLIENT_SECRET}'
  googleOAuthRedirectUri: '${GOOGLE_REDIRECT_URI}'
  googleDriveFolderId: '${GOOGLE_DRIVE_FOLDER_ID}'

  # Microsoft Calendar — optional; leave blank to disable
  microsoftClientId: '${MICROSOFT_CLIENT_ID}'
  microsoftClientSecret: '${MICROSOFT_CLIENT_SECRET}'
  microsoftOAuthRedirectUri: '${MICROSOFT_REDIRECT_URI}'
